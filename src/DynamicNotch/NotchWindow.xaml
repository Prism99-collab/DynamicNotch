<Window x:Class="DynamicNotch.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DynamicNotch.Controls"
        Title="Dynamic Notch" Width="560" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize" AllowDrop="True"
        Foreground="White" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">

    <Grid x:Name="Root">
        <!-- aura: an alert casts a faint glow of its colour just below the notch -->
        <Border x:Name="Aura" HorizontalAlignment="Center" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0" />
        <!-- Ear | notch | ear, always centered at the top of the screen -->
        <StackPanel x:Name="Shell" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Path x:Name="EarL" Width="10" Height="10" VerticalAlignment="Top" Fill="Black"
                  Data="M0,0 L10,0 L10,10 A10,10 0 0 0 0,0 Z" />

            <Border x:Name="Pill" Width="118" Height="6" CornerRadius="0,0,3,3" VerticalAlignment="Top">
                <!-- pure black where it meets the bezel, a breath lighter at the bottom for depth -->
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#000000" Offset="0" />
                        <GradientStop Color="#000000" Offset="0.55" />
                        <GradientStop Color="#0B0B0E" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid x:Name="Stage">

                    <!-- ===== Compact music activity ===== -->
                    <Grid x:Name="CompactMedia" Width="252" Height="30" HorizontalAlignment="Center" VerticalAlignment="Top"
                          Visibility="Collapsed" Opacity="0">
                        <Border x:Name="CompactArt" Width="20" Height="20" CornerRadius="6" HorizontalAlignment="Left"
                                VerticalAlignment="Center" Margin="13,0,0,1" Background="#2A2A2E" />
                        <StackPanel x:Name="Eq" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Height="13" Margin="0,0,15,1">
                            <Rectangle Width="3" Height="13" RadiusX="1.5" RadiusY="1.5" Margin="1.2,0" Fill="White" VerticalAlignment="Bottom" />
                            <Rectangle Width="3" Height="13" RadiusX="1.5" RadiusY="1.5" Margin="1.2,0" Fill="White" VerticalAlignment="Bottom" />
                            <Rectangle Width="3" Height="13" RadiusX="1.5" RadiusY="1.5" Margin="1.2,0" Fill="White" VerticalAlignment="Bottom" />
                            <Rectangle Width="3" Height="13" RadiusX="1.5" RadiusY="1.5" Margin="1.2,0" Fill="White" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </Grid>

                    <!-- ===== In a game: the frame rate, nothing else ===== -->
                    <Grid x:Name="GamePanel" Width="54" Height="18" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1">
                            <TextBlock x:Name="GameFps" FontSize="11" FontWeight="SemiBold" Foreground="#D9FFFFFF" VerticalAlignment="Center"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" Typography.NumeralAlignment="Tabular" Text="–" />
                            <TextBlock x:Name="GameFpsUnit" Text="fps" FontSize="8.5" Foreground="#73FFFFFF" VerticalAlignment="Center" Margin="2,1,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- ===== Compact generic activity (timer, download) ===== -->
                    <Grid x:Name="CompactActivity" Width="230" Height="30" HorizontalAlignment="Center" VerticalAlignment="Top"
                          Visibility="Collapsed" Opacity="0">
                        <TextBlock x:Name="ActGlyph" FontFamily="{StaticResource IconFont}" FontSize="14" HorizontalAlignment="Left"
                                   VerticalAlignment="Center" Margin="16,0,0,1" />
                        <!-- on a call: the app's icon with a live green dot -->
                        <Grid x:Name="CallArtHost" Width="22" Height="20" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="13,0,0,1" Visibility="Collapsed">
                            <Border x:Name="CallArt" Width="20" Height="20" CornerRadius="6" HorizontalAlignment="Left" Background="#2A2A2E" />
                            <Ellipse x:Name="CallDot" Width="7" Height="7" Fill="#30D158" Stroke="Black" StrokeThickness="1.4"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,1">
                            <!-- your voice, live -->
                            <StackPanel x:Name="CallBars" Orientation="Horizontal" Height="12" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed">
                                <Rectangle Width="2.6" Height="12" RadiusX="1.3" RadiusY="1.3" Margin="1,0" Fill="#30D158" VerticalAlignment="Center" />
                                <Rectangle Width="2.6" Height="12" RadiusX="1.3" RadiusY="1.3" Margin="1,0" Fill="#30D158" VerticalAlignment="Center" />
                                <Rectangle Width="2.6" Height="12" RadiusX="1.3" RadiusY="1.3" Margin="1,0" Fill="#30D158" VerticalAlignment="Center" />
                                <Rectangle Width="2.6" Height="12" RadiusX="1.3" RadiusY="1.3" Margin="1,0" Fill="#30D158" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="ActText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       FontFamily="Segoe UI Variable Display, Segoe UI" Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                    </Grid>

                    <!-- ===== Transient pop-up ===== -->
                    <Grid x:Name="Osd" Width="300" Height="36" HorizontalAlignment="Center" VerticalAlignment="Top"
                          Visibility="Collapsed" Opacity="0">
                        <!-- each pop-up's own colour, glowing softly from behind its icon -->
                        <Border x:Name="OsdGlow" IsHitTestVisible="False" Opacity="0" />
                        <Grid x:Name="OsdInner" Margin="18,0,14,3">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="OsdInnerShift" />
                            </Grid.RenderTransform>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="OsdChevron" Grid.Column="3" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       Foreground="White" Opacity="0" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <Grid x:Name="OsdIconHost" Width="22" Height="22" VerticalAlignment="Center">
                                <TextBlock x:Name="OsdGlyph" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border x:Name="OsdArt" CornerRadius="7" Visibility="Collapsed" />
                                <c:BatteryIcon x:Name="OsdBattery" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                            <c:PillSlider x:Name="OsdBar" Grid.Column="1" Margin="12,0" Height="14" TrackHeight="5"
                                          IsInteractive="False" IsHitTestVisible="False" VerticalAlignment="Center" />
                            <StackPanel x:Name="OsdTextPanel" Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="OsdTitle" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="OsdSub" FontSize="11" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="OsdRight" Grid.Column="2" FontSize="11.5" FontWeight="SemiBold" Foreground="#D0FFFFFF"
                                       VerticalAlignment="Center" TextAlignment="Right" MaxWidth="90" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Grid>

                    <!-- ===== Drop zone: a file is being dragged to the notch ===== -->
                    <Grid x:Name="DropPanel" Width="380" Height="92" HorizontalAlignment="Center" VerticalAlignment="Top"
                          Visibility="Collapsed" Opacity="0">
                        <!-- the receptacle: a marching dashed outline that turns solid when the file is over it -->
                        <Rectangle x:Name="DropOutline" Margin="12,8,12,10" RadiusX="18" RadiusY="18" StrokeThickness="1.4"
                                   Stroke="#66FFFFFF" StrokeDashArray="3 2.4" />
                        <Border x:Name="DropFill" Margin="12,8,12,10" CornerRadius="18" Background="#0A84FF" Opacity="0" />
                        <Grid Margin="26,8,24,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DropArrow" Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="22" Foreground="#0A84FF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.RenderTransform>
                                    <TranslateTransform x:Name="DropArrowShift" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock x:Name="DropTitle" Text="Drop to keep it here" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock x:Name="DropSub" Text="On the shelf until you drag it out" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,2,0,0" />
                            </StackPanel>
                            <!-- what's already on the shelf, fanned out like cards -->
                            <Canvas x:Name="DropStack" Grid.Column="2" Width="58" Height="40" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>

                    <!-- ===== Expanded: swipeable pages ===== -->
                    <Grid x:Name="Expanded" Width="440" Height="268" HorizontalAlignment="Center" VerticalAlignment="Top"
                          Visibility="Collapsed" Opacity="0" UseLayoutRounding="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="216" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- mood light: the playing song's colours, glowing from behind the album art -->
                        <Border x:Name="MediaGlow" Grid.RowSpan="3" IsHitTestVisible="False" Opacity="0" />

                        <!-- status line -->
                        <Grid Margin="24,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="ClockText" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="DateText" FontSize="12" Foreground="{StaticResource Dim}" Margin="7,0,0,0" VerticalAlignment="Bottom" />
                                <!-- mouse / headset batteries: tiny rings (Home only) -->
                                <StackPanel x:Name="DeviceRings" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock x:Name="PageTitle" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Dim}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <!-- with several things live: pick which one the notch shows -->
                            <Grid x:Name="LiveSwitch" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                                <Border x:Name="LiveHighlight" Width="30" Height="22" CornerRadius="11" BorderThickness="1"
                                        HorizontalAlignment="Left" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="LiveHighlightScale" />
                                            <TranslateTransform x:Name="LiveHighlightShift" />
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                </Border>
                                <StackPanel x:Name="LiveChips" Orientation="Horizontal" Margin="0,0,-4,0" />
                            </Grid>
                            <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand">
                                <!-- cyberpunk theme: on / off -->
                                <Button x:Name="CyberBtn" Width="22" Height="22" Margin="0,0,8,0" Cursor="Hand" Background="#FEE801" BorderBrush="#9A9F17" Foreground="#00060E">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid x:Name="CyberBg" Background="Transparent">
                                                <Path Stretch="Fill" Data="M0,0 L15,0 L22,7 L22,22 L7,22 L0,15 Z" Fill="{TemplateBinding Background}"
                                                      Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.2" StrokeLineJoin="Miter" />
                                                <TextBlock Text="&#xE790;" FontFamily="{StaticResource IconFont}" FontSize="10.5" Foreground="{TemplateBinding Foreground}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CyberBg" Property="Opacity" Value="0.85" /></Trigger>
                                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="CyberBg" Property="Opacity" Value="0.65" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <!-- lock: the notch stays, but stops reacting (unlock from its tray icon) -->
                                <Button x:Name="LockBtn" Width="22" Height="22" Margin="0,0,10,0" Cursor="Hand"
                                        ToolTip="Lock the notch · unlock from the tray icon">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Ellipse x:Name="LockBg">
                                                    <Ellipse.Fill>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#FFE15A" Offset="0" />
                                                            <GradientStop Color="#FF9F0A" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Ellipse.Fill>
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect Color="#FF9F0A" BlurRadius="10" ShadowDepth="0" Opacity="0.55" />
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="10.5" Foreground="#1C1C1E"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LockBg" Property="Opacity" Value="0.85" /></Trigger>
                                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="LockBg" Property="Opacity" Value="0.65" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <TextBlock x:Name="PrivacyText" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="BatteryText" FontSize="12" Foreground="#D9FFFFFF" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <c:BatteryIcon x:Name="Battery" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="Pager" Grid.Row="1" ClipToBounds="True" Background="Transparent">
                            <Canvas>
                                <StackPanel x:Name="PagesStrip" Orientation="Horizontal">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="PagesShift" />
                                    </StackPanel.RenderTransform>

                                    <!-- ================= PAGE 1 · HOME ================= -->
                                    <Grid Width="440" Height="216">
                                        <Grid Margin="22,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="64" />
                                                <RowDefinition x:Name="HomeGap1" Height="14" />
                                                <RowDefinition Height="64" />
                                                <RowDefinition x:Name="HomeGap2" Height="10" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Grid x:Name="MediaRow">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="ArtBox" Width="64" Height="64" CornerRadius="14" Background="#1E1E21">
                                                    <TextBlock x:Name="ArtPlaceholder" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                                               Foreground="#55FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="ArtistText" FontSize="12" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                                    <Grid x:Name="ProgressRow" Margin="0,7,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="ElapsedText" FontSize="10" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                                                        <c:PillSlider x:Name="ProgressSlider" Grid.Column="1" Height="14" TrackHeight="4" Margin="8,0" />
                                                        <TextBlock x:Name="RemainText" Grid.Column="2" FontSize="10" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button x:Name="PrevBtn" Style="{StaticResource CircleButton}" Width="34" Height="34">
                                                        <Path Data="M21,6 L12.5,12 L21,18 Z M12,6 L3.5,12 L12,18 Z" Fill="White" Stroke="White" StrokeThickness="1.4"
                                                              StrokeLineJoin="Round" Stretch="Uniform" Width="17" />
                                                    </Button>
                                                    <Button x:Name="PlayBtn" Style="{StaticResource CircleButton}" Width="40" Height="40" Margin="2,0">
                                                        <Grid>
                                                            <Path x:Name="PlayIcon" Data="M7,4.5 L19.5,12 L7,19.5 Z" Fill="White" Stroke="White" StrokeThickness="1.6"
                                                                  StrokeLineJoin="Round" Stretch="Uniform" Width="15" Margin="3,0,0,0" />
                                                            <Path x:Name="PauseIcon" Data="M6,4 L10,4 L10,20 L6,20 Z M14,4 L18,4 L18,20 L14,20 Z" Fill="White" Stroke="White"
                                                                  StrokeThickness="1.4" StrokeLineJoin="Round" Stretch="Uniform" Width="14" Visibility="Collapsed" />
                                                        </Grid>
                                                    </Button>
                                                    <Button x:Name="NextBtn" Style="{StaticResource CircleButton}" Width="34" Height="34">
                                                        <Path Data="M3,6 L11.5,12 L3,18 Z M12,6 L20.5,12 L12,18 Z" Fill="White" Stroke="White" StrokeThickness="1.4"
                                                              StrokeLineJoin="Round" Stretch="Uniform" Width="17" />
                                                    </Button>
                                                </StackPanel>
                                                <!-- volume of just the app that's playing (Spotify, the browser...); shown when it has a sound session -->
                                                <Grid x:Name="AppVolRow" Height="20" Margin="0,2,0,0" Visibility="Collapsed">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="AppVolGlyph" Text="&#xE995;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                               Foreground="{StaticResource Dim}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <c:PillSlider x:Name="AppVolSlider" Grid.Column="1" Height="20" TrackHeight="6" Margin="4,0,4,0" />
                                                </Grid>
                                                </StackPanel>
                                            </Grid>

                                            <!-- a call and music at once: two dots say there's another card (scroll / drag up or down) -->
                                            <StackPanel x:Name="CardDots" Width="4" Margin="-12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Visibility="Collapsed" IsHitTestVisible="False">
                                                <Border Width="4" Height="14" CornerRadius="2" Margin="0,0,0,3" />
                                                <Border Width="4" Height="4" CornerRadius="2" />
                                            </StackPanel>
                                            <!-- on a call: the call card takes the music's place -->
                                            <Grid x:Name="CallRow" Visibility="Collapsed">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="64" Height="64">
                                                    <Border x:Name="CallCardArt" CornerRadius="14" Background="#1E1E21" />
                                                    <!-- a soft green ring that breathes with your voice -->
                                                    <Border x:Name="CallRing" CornerRadius="16" Margin="-3" BorderThickness="2" BorderBrush="#30D158" Opacity="0.35" />
                                                </Grid>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock x:Name="CallTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <Ellipse x:Name="CallCardDot" Width="7" Height="7" Fill="#30D158" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBlock x:Name="CallSub" FontSize="12" Foreground="{StaticResource Dim}" Typography.NumeralAlignment="Tabular" />
                                                    </StackPanel>
                                                    <StackPanel x:Name="CallVoice" Orientation="Horizontal" Height="14" Margin="0,8,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <Button x:Name="CallMuteBtn" Style="{StaticResource CircleButton}" Width="42" Height="42" ToolTip="Mute / unmute your microphone">
                                                        <Grid>
                                                            <Ellipse x:Name="CallMuteBg" Fill="#26262A" />
                                                            <TextBlock x:Name="CallMuteGlyph" Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Button>
                                                    <Button x:Name="CallBackBtn" Style="{StaticResource CircleButton}" Width="36" Height="36" Margin="6,0,0,0" ToolTip="Back to the call">
                                                        <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <UniformGrid x:Name="TogglesRow" Grid.Row="2" Columns="6">
                                                <c:QuickToggle x:Name="WifiTile" Glyph="&#xE701;" Label="Wi-Fi" ToolTip="Wi-Fi · right-click for settings" />
                                                <c:QuickToggle x:Name="BtTile" Glyph="&#xE702;" Label="Bluetooth" ToolTip="Bluetooth · right-click for settings" />
                                                <c:QuickToggle x:Name="AirTile" Glyph="&#xE709;" Label="Airplane" OnBrush="#FF9F0A" />
                                                <c:QuickToggle x:Name="FocusTile" Glyph="&#xE708;" Label="Focus" OnBrush="#5E5CE6" ToolTip="Focus · do not disturb" />
                                                <c:QuickToggle x:Name="MicTile" Glyph="&#xE720;" Label="Mic on" OnBrush="#FF453A" />
                                                <c:QuickToggle x:Name="PowerTile" Glyph="&#xEC49;" Label="Balanced" ToolTip="Power mode" />
                                            </UniformGrid>

                                            <Grid x:Name="DevicesPanel" Grid.RowSpan="3" Visibility="Collapsed" Opacity="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="28" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <!-- speakers / headphones vs microphones, one list at a time -->
                                                <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center">
                                                    <Button x:Name="OutputTab" Style="{StaticResource Capsule}" Height="24" Padding="11,0" Margin="0,0,4,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE7F5;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <TextBlock Text="Output" FontSize="11.5" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button x:Name="InputTab" Style="{StaticResource Capsule}" Height="24" Padding="11,0" Margin="0,0,4,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <TextBlock Text="Input" FontSize="11.5" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                    <!-- every app's own volume -->
                                                    <Button x:Name="MixerTab" Style="{StaticResource Capsule}" Height="24" Padding="11,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE9E9;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <TextBlock Text="Apps" FontSize="11.5" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" PanningMode="VerticalOnly">
                                                    <!-- soft bottom edge: a longer list reads as "scroll for more" instead of a cut-off row -->
                                                    <ScrollViewer.OpacityMask>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="Black" Offset="0.8" />
                                                            <GradientStop Color="Transparent" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </ScrollViewer.OpacityMask>
                                                    <StackPanel x:Name="DevicesList" Margin="0,0,0,14" />
                                                </ScrollViewer>
                                            </Grid>

                                            <StackPanel Grid.Row="4" VerticalAlignment="Bottom">
                                                <Grid x:Name="VolRow" Height="30">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="30" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="MuteBtn" Style="{StaticResource CircleButton}" ToolTip="Mute">
                                                        <TextBlock x:Name="VolGlyph" Text="&#xE995;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                                                    </Button>
                                                    <c:PillSlider x:Name="VolSlider" Grid.Column="1" Height="24" TrackHeight="6" Margin="8,0" />
                                                    <Button x:Name="OutputBtn" Grid.Column="2" Style="{StaticResource CircleButton}">
                                                        <TextBlock x:Name="OutputGlyph" Text="&#xE7F5;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                                                    </Button>
                                                </Grid>
                                                <Grid x:Name="BriRow" Height="30" Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="30" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="BriGlyph" Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <c:PillSlider x:Name="BriSlider" Grid.Column="1" Height="24" TrackHeight="6" Margin="8,0" />
                                                    <TextBlock x:Name="BriText" Grid.Column="2" FontSize="10.5" Foreground="{StaticResource Dim}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                                <!-- external monitor (DDC/CI); only shown when one answers -->
                                                <Grid x:Name="ExtBriRow" Height="30" Margin="0,2,0,0" Visibility="Collapsed" ToolTip="Monitor brightness">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="30" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock x:Name="ExtBriGlyph" Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <c:PillSlider x:Name="ExtBriSlider" Grid.Column="1" Height="24" TrackHeight="6" Margin="8,0" />
                                                    <TextBlock x:Name="ExtBriText" Grid.Column="2" FontSize="10.5" Foreground="{StaticResource Dim}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>

                                    <!-- ================= PAGE 2 · SYSTEM ================= -->
                                    <Grid Width="440" Height="216">
                                        <Grid Margin="22,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="84" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="28" />
                                                <RowDefinition Height="6" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <UniformGrid Columns="4">
                                                <StackPanel>
                                                    <Grid Width="58" Height="58">
                                                        <c:RingGauge x:Name="CpuRing" RingBrush="#0A84FF" />
                                                        <TextBlock x:Name="CpuText" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock Text="CPU" FontSize="10.5" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <Grid Width="58" Height="58">
                                                        <c:RingGauge x:Name="RamRing" RingBrush="#BF5AF2" />
                                                        <TextBlock x:Name="RamText" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock x:Name="RamLabel" Text="Memory" FontSize="10.5" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <Grid Width="58" Height="58">
                                                        <c:RingGauge x:Name="DiskRing" RingBrush="#64D2FF" />
                                                        <TextBlock x:Name="DiskText" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock x:Name="DiskLabel" Text="Disk C:" FontSize="10.5" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <Grid Width="58" Height="58">
                                                        <c:RingGauge x:Name="BatRing" RingBrush="#30D158" />
                                                        <TextBlock x:Name="BatText" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock x:Name="BatLabel" Text="Battery" FontSize="10.5" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                                </StackPanel>
                                            </UniformGrid>
                                            <Border Grid.Row="2" CornerRadius="10" Background="#17171A">
                                                <Grid Margin="12,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE74B;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#30D158" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="NetDown" FontSize="11.5" Margin="6,0,0,0" Typography.NumeralAlignment="Tabular" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#0A84FF" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="NetUp" FontSize="11.5" Margin="6,0,0,0" Typography.NumeralAlignment="Tabular" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="UptimeText" FontSize="11.5" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Grid x:Name="SysCards" Grid.Row="4" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <!-- connection quality -->
                                                <Border CornerRadius="14" Background="#17171A" Padding="13,8,13,8">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <Grid>
                                                            <TextBlock x:Name="NetName" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,30,0" />
                                                            <StackPanel x:Name="SignalBars" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Height="12">
                                                                <Rectangle Width="3" Height="4" RadiusX="1" RadiusY="1" Margin="1,0" VerticalAlignment="Bottom" Fill="#3AFFFFFF" />
                                                                <Rectangle Width="3" Height="6.5" RadiusX="1" RadiusY="1" Margin="1,0" VerticalAlignment="Bottom" Fill="#3AFFFFFF" />
                                                                <Rectangle Width="3" Height="9" RadiusX="1" RadiusY="1" Margin="1,0" VerticalAlignment="Bottom" Fill="#3AFFFFFF" />
                                                                <Rectangle Width="3" Height="12" RadiusX="1" RadiusY="1" Margin="1,0" VerticalAlignment="Bottom" Fill="#3AFFFFFF" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock x:Name="NetQuality" FontSize="10.5" Foreground="{StaticResource Dim}" Margin="0,2,0,0" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                            <Ellipse x:Name="PingDot" Width="6" Height="6" Fill="#3AFFFFFF" VerticalAlignment="Center" />
                                                            <TextBlock Text="Ping" FontSize="11" Foreground="{StaticResource Dim}" Margin="6,0,0,0" />
                                                            <TextBlock x:Name="PingText" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" Typography.NumeralAlignment="Tabular" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <!-- battery health -->
                                                <Border Grid.Column="2" CornerRadius="14" Background="#17171A">
                                                    <Grid>
                                                        <StackPanel VerticalAlignment="Center" Margin="13,8,13,8">
                                                            <Grid>
                                                                <TextBlock Text="Battery health" FontSize="12" FontWeight="SemiBold" />
                                                                <TextBlock x:Name="HealthText" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                            </Grid>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock x:Name="ChargeBolt" Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="#30D158"
                                                                           VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Collapsed" />
                                                                <TextBlock x:Name="DrawText" FontSize="10.5" Foreground="{StaticResource Dim}" />
                                                            </StackPanel>
                                                            <TextBlock x:Name="CapacityText" FontSize="11" Margin="0,5,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            <!-- a download in progress: name, live speed, real progress (the browser's own total) -->
                                            <Border x:Name="DlCard" Grid.Row="4" Margin="0,0,0,8" CornerRadius="14" Background="#1A1A1E" BorderBrush="#260A84FF" BorderThickness="1"
                                                    Visibility="Collapsed" Opacity="0">
                                                <Border.RenderTransform>
                                                    <TranslateTransform x:Name="DlCardShift" />
                                                </Border.RenderTransform>
                                                <Grid>
                                                    <Grid Margin="12,9,13,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="*" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Border x:Name="DlIcon" Width="34" Height="34" CornerRadius="8" Background="#262629" VerticalAlignment="Center">
                                                            <TextBlock x:Name="DlGlyph" Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="15" Foreground="#0A84FF"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                                                            <TextBlock x:Name="DlName" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock x:Name="DlDetail" FontSize="10.5" Foreground="{StaticResource Dim}" Margin="0,2,0,0"
                                                                       TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" />
                                                        </StackPanel>
                                                        <TextBlock x:Name="DlPercent" Grid.Column="2" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                   FontFamily="Segoe UI Variable Display, Segoe UI" Typography.NumeralAlignment="Tabular" />
                                                        <StackPanel x:Name="DlActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                                            <Button x:Name="DlOpen" Style="{StaticResource Capsule}" Height="28" Padding="12,0" Content="Open" />
                                                            <Button x:Name="DlFolder" Style="{StaticResource CircleButton}" Width="28" Height="28" Margin="6,0,0,0" ToolTip="Show in folder">
                                                                <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                                                            </Button>
                                                        </StackPanel>
                                                        <!-- progress: the real share when the size is known, a travelling light while it isn't -->
                                                        <Grid x:Name="DlTrack" Grid.Row="1" Grid.ColumnSpan="3" Height="5" Margin="0,8,0,0" ClipToBounds="True">
                                                            <Border CornerRadius="2.5" Background="#22FFFFFF" />
                                                            <Border x:Name="DlFill" CornerRadius="2.5" HorizontalAlignment="Left" Width="0">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                        <GradientStop Color="#0A84FF" Offset="0" />
                                                                        <GradientStop Color="#64D2FF" Offset="1" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                            </Border>
                                                            <Border x:Name="DlSheen" Width="70" HorizontalAlignment="Left" CornerRadius="2.5">
                                                                <Border.Background>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                        <GradientStop Color="#00FFFFFF" Offset="0" />
                                                                        <GradientStop Color="#A0FFFFFF" Offset="0.5" />
                                                                        <GradientStop Color="#00FFFFFF" Offset="1" />
                                                                    </LinearGradientBrush>
                                                                </Border.Background>
                                                                <Border.RenderTransform>
                                                                    <TranslateTransform x:Name="DlSheenShift" />
                                                                </Border.RenderTransform>
                                                            </Border>
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <!-- ================= PAGE 3 · TOOLS ================= -->
                                    <Grid Width="440" Height="216">
                                        <Grid Margin="22,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="178" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Pomodoro focus card: ring + time, focus / break, rounds -->
                                            <Border CornerRadius="20" Background="#17171A" Margin="0,2,0,6">
                                                <Grid Margin="12,9,12,10">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="24" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button x:Name="FocusTab" Style="{StaticResource Capsule}" Content="Focus" Height="22" Padding="10,0" FontSize="10.5" Margin="0,0,3,0" />
                                                        <Button x:Name="BreakTab" Style="{StaticResource Capsule}" Content="Break" Height="22" Padding="10,0" FontSize="10.5" />
                                                    </StackPanel>
                                                    <!-- completed focus rounds (4 make a set) -->
                                                    <StackPanel x:Name="RoundDots" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                Background="Transparent" ToolTip="Focus rounds · long break after 4" />

                                                    <!-- the ring: click to start / pause, scroll to change the minutes -->
                                                    <Grid x:Name="TimerFace" Grid.Row="1" Width="98" Height="98" Background="Transparent" Cursor="Hand" Margin="0,3,0,3"
                                                          ToolTip="Click: start / pause · scroll: minutes">
                                                        <c:RingGauge x:Name="TimerRing" RingBrush="#FF9F0A" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock x:Name="TimerText" Text="25:00" FontSize="25" FontWeight="Light" HorizontalAlignment="Center"
                                                                       FontFamily="Segoe UI Variable Display, Segoe UI" Typography.NumeralAlignment="Tabular" />
                                                            <TextBlock x:Name="TimerHint" Text="Focus" FontSize="9.5" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,-1,0,0" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <UniformGrid x:Name="TimerChips" Grid.Row="2" Columns="4" Margin="-2,0,-2,7">
                                                        <Button Style="{StaticResource Capsule}" Tag="15" Content="15" Height="22" Margin="2,0" Padding="0" FontSize="10.5" />
                                                        <Button Style="{StaticResource Capsule}" Tag="25" Content="25" Height="22" Margin="2,0" Padding="0" FontSize="10.5" />
                                                        <Button Style="{StaticResource Capsule}" Tag="45" Content="45" Height="22" Margin="2,0" Padding="0" FontSize="10.5" />
                                                        <Button Style="{StaticResource Capsule}" Tag="60" Content="60" Height="22" Margin="2,0" Padding="0" FontSize="10.5" />
                                                    </UniformGrid>

                                                    <Grid Grid.Row="3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="6" />
                                                            <ColumnDefinition Width="30" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button x:Name="TimerStart" Style="{StaticResource Capsule}" Background="#FF9F0A" Foreground="Black" Height="30" FontWeight="SemiBold">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock x:Name="TimerStartGlyph" Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                                <TextBlock x:Name="TimerStartText" Text="Start" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button x:Name="TimerReset" Grid.Column="2" Style="{StaticResource Capsule}" Height="30" Padding="0" ToolTip="Reset">
                                                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                                                        </Button>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <!-- colour-coded tools; right-click Clip history / Files for more -->
                                            <UniformGrid x:Name="ActionsGrid" Grid.Column="2" Columns="3" Rows="3" Margin="0,0,0,4">
                                                <c:QuickToggle Style="{StaticResource ActionTile}" Tag="snip" Glyph="&#xE924;" Label="Snip" TintBrush="#0A84FF" ToolTip="Screenshot (Win+Shift+S)" />
                                                <c:QuickToggle x:Name="AwakeTile" Style="{StaticResource ActionTile}" Tag="awake" Glyph="&#xE7B3;" Label="Keep awake" TintBrush="#64D2FF" OnBrush="#64D2FF"
                                                               ToolTip="Keep the PC awake" />
                                                <c:QuickToggle Style="{StaticResource ActionTile}" Tag="clipboard" Glyph="&#xF0E3;" Label="Clip history" TintBrush="#BF5AF2"
                                                               ToolTip="Clipboard history (Win+V)" />
                                                <c:QuickToggle Style="{StaticResource ActionTile}" Tag="explorer" Glyph="&#xEC50;" Label="Files" TintBrush="#FFD60A" ToolTip="File Explorer · right-click: Downloads" />
                                                <c:QuickToggle Style="{StaticResource ActionTile}" Tag="terminal" Glyph="&#xE756;" Label="Terminal" TintBrush="#E5E5EA" />
                                                <c:QuickToggle Style="{StaticResource ActionTile}" Tag="taskmgr" Glyph="&#xE9D9;" Label="Task Manager" TintBrush="#30D158" />
                                                <c:QuickToggle Style="{StaticResource ActionTile}" Tag="calc" Glyph="&#xE8EF;" Label="Calculator" TintBrush="#FF9F0A" />
                                                <c:QuickToggle Style="{StaticResource ActionTile}" Tag="lock" Glyph="&#xE72E;" Label="Lock" TintBrush="#5E5CE6" ToolTip="Lock (Win+L)" />
                                                <c:QuickToggle Style="{StaticResource ActionTile}" Tag="sleep" Glyph="&#xE7E8;" Label="Sleep" TintBrush="#FF375F" ToolTip="Click twice to sleep" />
                                            </UniformGrid>
                                        </Grid>
                                    </Grid>

                                    <!-- ================= PAGE 4 · CLIPBOARD & FILES ================= -->
                                    <Grid Width="440" Height="216">
                                        <Grid Margin="22,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="26" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Clipboard" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="4,0" />
                                                <Button x:Name="ClipClear" Style="{StaticResource CircleButton}" Width="24" Height="24" HorizontalAlignment="Right" ToolTip="Clear">
                                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource Dim}" />
                                                </Button>
                                                <StackPanel x:Name="ClipList" Grid.Row="1" />
                                                <TextBlock x:Name="ClipEmpty" Grid.Row="1" Text="Copy text and it shows up here.&#x0a;Click an item to copy it again." TextWrapping="Wrap"
                                                           FontSize="11" Foreground="#66FFFFFF" Margin="4,8" />
                                            </Grid>
                                            <Grid Grid.Column="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="26" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button x:Name="ShelfTab" Style="{StaticResource Capsule}" Content="Shelf" Height="22" Padding="10,0" FontSize="10.5" Margin="0,0,3,0"
                                                            ToolTip="Your shelf · drag files out into any app" />
                                                    <Button x:Name="RecentTab" Style="{StaticResource Capsule}" Content="Recent" Height="22" Padding="10,0" FontSize="10.5" />
                                                </StackPanel>
                                                <Button x:Name="OpenDownloads" Style="{StaticResource CircleButton}" Width="24" Height="24" HorizontalAlignment="Right" ToolTip="Open Downloads">
                                                    <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource Dim}" />
                                                </Button>
                                                <Button x:Name="ShelfClear" Style="{StaticResource CircleButton}" Width="24" Height="24" HorizontalAlignment="Right" ToolTip="Clear the shelf" Visibility="Collapsed">
                                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource Dim}" />
                                                </Button>
                                                <StackPanel x:Name="FilesList" Grid.Row="1" />
                                                <ScrollViewer x:Name="ShelfScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" Visibility="Collapsed">
                                                    <StackPanel x:Name="ShelfList" />
                                                </ScrollViewer>
                                            </Grid>
                                        </Grid>
                                    </Grid>

                                    <!-- ================= PAGE 5 · COLORS (built the first time it's shown: NotchWindow.Studio) ================= -->
                                    <Grid x:Name="ColorsPage" Width="440" Height="216" />

                                    <!-- ================= PAGE 6 · SETTINGS: Display · Behaviour · Smart, one page ================= -->
                                    <Grid Width="440" Height="216">
                                        <Grid Margin="22,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="30" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="14" />
                                            </Grid.RowDefinitions>
                                            <StackPanel x:Name="SettingsTabs" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <UniformGrid x:Name="SettingsGrid" Grid.Row="1" Columns="2" Rows="4" />
                                            <UniformGrid x:Name="BehaviourGrid" Grid.Row="1" Columns="2" Rows="5" Visibility="Collapsed" />
                                            <Grid x:Name="SmartPanel" Grid.Row="1" Visibility="Collapsed">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="36" />
                                                </Grid.RowDefinitions>
                                                <UniformGrid x:Name="SmartGrid" Columns="2" Rows="4" />
                                                <Border Grid.Row="1" CornerRadius="12" Background="#17171A" Margin="0,2,0,4" Padding="12,0,6,0">
                                                    <Grid>
                                                        <TextBlock x:Name="BreakLabel" Text="Break reminder every" FontSize="11.5" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                                                        <StackPanel x:Name="BreakChips" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            <TextBlock x:Name="SettingsHint" Grid.Row="2" FontSize="9" Foreground="#59FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Text="Win+Alt+N opens the notch · drag sideways or swipe the touchpad to change page" />
                                        </Grid>
                                    </Grid>

                                </StackPanel>
                            </Canvas>
                        </Grid>

                        <!-- "+N": everything live in one list, when the chips don't fit -->
                        <Border x:Name="LiveMenu" Grid.Row="1" Grid.RowSpan="2" Width="270" HorizontalAlignment="Center" VerticalAlignment="Top"
                                Margin="0,2,0,0" Padding="6" CornerRadius="14" Background="#F51C1C1F" BorderBrush="#2AFFFFFF" BorderThickness="1"
                                Visibility="Collapsed" Opacity="0" Panel.ZIndex="10" RenderTransformOrigin="0.5,0">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="LiveMenuScale" />
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.6" Color="Black" />
                            </Border.Effect>
                            <ScrollViewer MaxHeight="196" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
                                <StackPanel x:Name="LiveMenuList" />
                            </ScrollViewer>
                        </Border>
                        <StackPanel x:Name="Dots" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
                    </Grid>

                    <!-- thin coloured rim along the notch's sides and bottom (colour set from code) -->
                    <!-- good news: a soft band of light sweeps across the notch once, in the alert's colour -->
                    <Border x:Name="Shine" Width="110" HorizontalAlignment="Left" IsHitTestVisible="False" Opacity="0">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ShineShift" />
                        </Border.RenderTransform>
                    </Border>
                    <!-- slim over a window but something's live: a thin line glowing in the music's / activity's colour -->
                    <Border x:Name="SlimGlow" Height="2.5" CornerRadius="1.25" VerticalAlignment="Bottom" Margin="12,0,12,1"
                            IsHitTestVisible="False" Opacity="0" />
                    <Border x:Name="Rim" BorderThickness="1,0,1,1" CornerRadius="0,0,3,3" IsHitTestVisible="False" BorderBrush="Transparent" />
                </Grid>
            </Border>

            <Path x:Name="EarR" Width="10" Height="10" VerticalAlignment="Top" Fill="Black"
                  Data="M10,0 L0,0 L0,10 A10,10 0 0 1 10,0 Z" />
        </StackPanel>

        <!-- A second live activity splits off into its own little island on the left -->
        <Border x:Name="SecondBubble" Background="Black" Height="22" MinWidth="24" CornerRadius="0,0,11,11" Padding="7,0"
                HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SecondScale" />
                    <TranslateTransform x:Name="SecondShift" />
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
                <!-- a soft glow of its colour beneath it -->
                <Border x:Name="SecondAura" VerticalAlignment="Bottom" Height="26" Margin="-26,0,-26,-24" IsHitTestVisible="False" Opacity="0.4" />
                <!-- ears: it hangs from the top edge like the notch itself -->
                <Path Width="7" Height="7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-14,0,0,0" Fill="Black"
                      Data="M0,0 L7,0 L7,7 A7,7 0 0 0 0,0 Z" />
                <Path Width="7" Height="7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-14,0" Fill="Black"
                      Data="M7,0 L0,0 L0,7 A7,7 0 0 1 7,0 Z" />
                <!-- the neck: black between it and the notch while it splits off (or merges back), pinching thin -->
                <Border x:Name="SecondNeck" Background="Black" HorizontalAlignment="Right" VerticalAlignment="Top" Width="27" Height="0"
                        Margin="0,0,-30,0" CornerRadius="0,0,8,8" IsHitTestVisible="False" />
                <Border x:Name="SecondRim" BorderThickness="1,0,1,1" CornerRadius="0,0,11,11" Margin="-7,0" BorderBrush="Transparent" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,1">
                    <Border x:Name="SecondArt" Width="16" Height="16" CornerRadius="8" Visibility="Collapsed" />
                    <Grid>
                        <!-- a download's real progress, around its arrow -->
                        <Path x:Name="SecondRing" Width="17" Height="17" Stroke="#0A84FF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        <TextBlock x:Name="SecondGlyph" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Grid>
                    <TextBlock x:Name="SecondText" FontSize="11.5" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Display, Segoe UI" Typography.NumeralAlignment="Tabular" />
                    <TextBlock x:Name="SecondMore" FontSize="10" FontWeight="SemiBold" Foreground="#8CFFFFFF" Margin="5,0,0,0" VerticalAlignment="Center"
                               Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Mic / camera in use: a small companion bubble next to the notch -->
        <Border x:Name="PrivacyBubble" Background="Black" Height="22" CornerRadius="0,0,11,11" Padding="7,0"
                HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PrivacyScale" />
                    <TranslateTransform x:Name="PrivacyShift" />
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
            <Border x:Name="PrivacyAura" VerticalAlignment="Bottom" Height="24" Margin="-22,0,-22,-22" IsHitTestVisible="False" Opacity="0.45" />
            <Path Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-13,0,0,0" Fill="Black"
                  Data="M0,0 L6,0 L6,6 A6,6 0 0 0 0,0 Z" />
            <Path Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,-13,0" Fill="Black"
                  Data="M6,0 L0,0 L0,6 A6,6 0 0 1 6,0 Z" />
            <Border x:Name="PrivacyNeck" Background="Black" HorizontalAlignment="Left" VerticalAlignment="Top" Width="24" Height="0"
                    Margin="-27,0,0,0" CornerRadius="0,0,7,7" IsHitTestVisible="False" />
            <Border x:Name="PrivacyRim" BorderThickness="1,0,1,1" CornerRadius="0,0,11,11" Margin="-7,0" BorderBrush="Transparent" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,1">
                <Grid x:Name="MicDot" Margin="0,0,0,0">
                    <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#FF9F0A" VerticalAlignment="Center" />
                </Grid>
                <Grid x:Name="CamDot" Margin="6,0,0,0">
                    <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#30D158" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
            </Grid>
        </Border>
        <!-- drag catcher: invisible but hit-testable, switched on only while something is dragged toward the notch -->
        <Border x:Name="DropCatcher" Width="540" Height="110" HorizontalAlignment="Center" VerticalAlignment="Top"
                Background="#01000000" Visibility="Collapsed" />
        <!-- hover hints, drawn in the notch so they sit in front and match it -->
        <Border x:Name="Tip" Panel.ZIndex="100" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed" Opacity="0"
                Background="#F2232326" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10,6,10,7"
                RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="TipScale" />
                    <TranslateTransform x:Name="TipShift" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.55" Color="Black" />
            </Border.Effect>
            <TextBlock x:Name="TipText" MaxWidth="280" TextWrapping="Wrap" FontSize="11.5" Foreground="#EBFFFFFF" LineHeight="16" />
        </Border>
    </Grid>
</Window>
