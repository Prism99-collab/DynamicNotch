<Window x:Class="DynamicNotch.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DynamicNotch.Controls"
        Title="Dynamic Notch" Width="560" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Foreground="White" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale">

    <Grid x:Name="Root">
        <!-- Ear | notch | ear, always centered at the top of the screen -->
        <StackPanel x:Name="Shell" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Path x:Name="EarL" Width="10" Height="10" VerticalAlignment="Top" Fill="Black"
                  Data="M0,0 L10,0 L10,10 A10,10 0 0 0 0,0 Z" />

            <Border x:Name="Pill" Background="Black" Width="118" Height="6" CornerRadius="0,0,3,3" VerticalAlignment="Top">
                <Grid x:Name="Stage">

                    <!-- ===== Compact music activity ===== -->
                    <Grid x:Name="CompactMedia" Width="252" Height="30" HorizontalAlignment="Center" VerticalAlignment="Top"
                          Visibility="Collapsed" Opacity="0">
                        <Border x:Name="CompactArt" Width="20" Height="20" CornerRadius="6" HorizontalAlignment="Left"
                                VerticalAlignment="Center" Margin="13,0,0,1" Background="#2A2A2E" />
                        <StackPanel x:Name="Eq" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Height="13" Margin="0,0,15,1">
                            <Rectangle Width="3" Height="13" RadiusX="1.5" RadiusY="1.5" Margin="1.2,0" Fill="White" VerticalAlignment="Bottom" />
                            <Rectangle Width="3" Height="13" RadiusX="1.5" RadiusY="1.5" Margin="1.2,0" Fill="White" VerticalAlignment="Bottom" />
                            <Rectangle Width="3" Height="13" RadiusX="1.5" RadiusY="1.5" Margin="1.2,0" Fill="White" VerticalAlignment="Bottom" />
                            <Rectangle Width="3" Height="13" RadiusX="1.5" RadiusY="1.5" Margin="1.2,0" Fill="White" VerticalAlignment="Bottom" />
                        </StackPanel>
                    </Grid>

                    <!-- ===== Compact generic activity (timer, download) ===== -->
                    <Grid x:Name="CompactActivity" Width="230" Height="30" HorizontalAlignment="Center" VerticalAlignment="Top"
                          Visibility="Collapsed" Opacity="0">
                        <TextBlock x:Name="ActGlyph" FontFamily="{StaticResource IconFont}" FontSize="14" HorizontalAlignment="Left"
                                   VerticalAlignment="Center" Margin="16,0,0,1" />
                        <TextBlock x:Name="ActText" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,16,1" FontFamily="Segoe UI Variable Display, Segoe UI" Typography.NumeralAlignment="Tabular" />
                    </Grid>

                    <!-- ===== Transient pop-up ===== -->
                    <Grid x:Name="Osd" Width="300" Height="36" HorizontalAlignment="Center" VerticalAlignment="Top"
                          Visibility="Collapsed" Opacity="0">
                        <!-- each pop-up's own colour, glowing softly from behind its icon -->
                        <Border x:Name="OsdGlow" IsHitTestVisible="False" Opacity="0" />
                        <Grid x:Name="OsdInner" Margin="18,0,14,3">
                            <Grid.RenderTransform>
                                <TranslateTransform x:Name="OsdInnerShift" />
                            </Grid.RenderTransform>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="OsdChevron" Grid.Column="3" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                       Foreground="White" Opacity="0" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <Grid x:Name="OsdIconHost" Width="22" Height="22" VerticalAlignment="Center">
                                <TextBlock x:Name="OsdGlyph" FontFamily="{StaticResource IconFont}" FontSize="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border x:Name="OsdArt" CornerRadius="7" Visibility="Collapsed" />
                                <c:BatteryIcon x:Name="OsdBattery" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                            <c:PillSlider x:Name="OsdBar" Grid.Column="1" Margin="12,0" Height="14" TrackHeight="5"
                                          IsInteractive="False" IsHitTestVisible="False" VerticalAlignment="Center" />
                            <StackPanel x:Name="OsdTextPanel" Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="OsdTitle" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="OsdSub" FontSize="11" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="OsdRight" Grid.Column="2" FontSize="11.5" FontWeight="SemiBold" Foreground="#D0FFFFFF"
                                       VerticalAlignment="Center" TextAlignment="Right" MaxWidth="90" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Grid>

                    <!-- ===== Expanded: swipeable pages ===== -->
                    <Grid x:Name="Expanded" Width="440" Height="268" HorizontalAlignment="Center" VerticalAlignment="Top"
                          Visibility="Collapsed" Opacity="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="216" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- mood light: the playing song's colours, glowing from behind the album art -->
                        <Border x:Name="MediaGlow" Grid.RowSpan="3" IsHitTestVisible="False" Opacity="0" />

                        <!-- status line -->
                        <Grid Margin="24,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="ClockText" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock x:Name="DateText" FontSize="12" Foreground="{StaticResource Dim}" Margin="7,0,0,0" VerticalAlignment="Bottom" />
                            </StackPanel>
                            <TextBlock x:Name="PageTitle" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Dim}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <StackPanel x:Name="BatteryPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand">
                                <TextBlock x:Name="PrivacyText" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="BatteryText" FontSize="12" Foreground="#D9FFFFFF" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <c:BatteryIcon x:Name="Battery" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="Pager" Grid.Row="1" ClipToBounds="True" Background="Transparent">
                            <Canvas>
                                <StackPanel x:Name="PagesStrip" Orientation="Horizontal">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="PagesShift" />
                                    </StackPanel.RenderTransform>

                                    <!-- ================= PAGE 1 · HOME ================= -->
                                    <Grid Width="440" Height="216">
                                        <Grid Margin="22,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="64" />
                                                <RowDefinition Height="14" />
                                                <RowDefinition Height="64" />
                                                <RowDefinition Height="10" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Grid x:Name="MediaRow">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="64" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="ArtBox" Width="64" Height="64" CornerRadius="14" Background="#1E1E21">
                                                    <TextBlock x:Name="ArtPlaceholder" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="22"
                                                               Foreground="#55FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="ArtistText" FontSize="12" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                                    <Grid x:Name="ProgressRow" Margin="0,7,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock x:Name="ElapsedText" FontSize="10" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                                                        <c:PillSlider x:Name="ProgressSlider" Grid.Column="1" Height="14" TrackHeight="4" Margin="8,0" />
                                                        <TextBlock x:Name="RemainText" Grid.Column="2" FontSize="10" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <Button x:Name="PrevBtn" Style="{StaticResource CircleButton}" Width="34" Height="34">
                                                        <Path Data="M21,6 L12.5,12 L21,18 Z M12,6 L3.5,12 L12,18 Z" Fill="White" Stroke="White" StrokeThickness="1.4"
                                                              StrokeLineJoin="Round" Stretch="Uniform" Width="17" />
                                                    </Button>
                                                    <Button x:Name="PlayBtn" Style="{StaticResource CircleButton}" Width="40" Height="40" Margin="2,0">
                                                        <Grid>
                                                            <Path x:Name="PlayIcon" Data="M7,4.5 L19.5,12 L7,19.5 Z" Fill="White" Stroke="White" StrokeThickness="1.6"
                                                                  StrokeLineJoin="Round" Stretch="Uniform" Width="15" Margin="3,0,0,0" />
                                                            <Path x:Name="PauseIcon" Data="M6,4 L10,4 L10,20 L6,20 Z M14,4 L18,4 L18,20 L14,20 Z" Fill="White" Stroke="White"
                                                                  StrokeThickness="1.4" StrokeLineJoin="Round" Stretch="Uniform" Width="14" Visibility="Collapsed" />
                                                        </Grid>
                                                    </Button>
                                                    <Button x:Name="NextBtn" Style="{StaticResource CircleButton}" Width="34" Height="34">
                                                        <Path Data="M3,6 L11.5,12 L3,18 Z M12,6 L20.5,12 L12,18 Z" Fill="White" Stroke="White" StrokeThickness="1.4"
                                                              StrokeLineJoin="Round" Stretch="Uniform" Width="17" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <UniformGrid x:Name="TogglesRow" Grid.Row="2" Columns="6">
                                                <c:QuickToggle x:Name="WifiTile" Glyph="&#xE701;" Label="Wi-Fi" ToolTip="Wi-Fi (right-click for settings)" />
                                                <c:QuickToggle x:Name="BtTile" Glyph="&#xE702;" Label="Bluetooth" ToolTip="Bluetooth (right-click for settings)" />
                                                <c:QuickToggle x:Name="AirTile" Glyph="&#xE709;" Label="Airplane" OnBrush="#FF9F0A" />
                                                <c:QuickToggle x:Name="FocusTile" Glyph="&#xE708;" Label="Focus" OnBrush="#5E5CE6" ToolTip="Focus / Do not disturb" />
                                                <c:QuickToggle x:Name="MicTile" Glyph="&#xE720;" Label="Mic on" OnBrush="#FF453A" />
                                                <c:QuickToggle x:Name="PowerTile" Glyph="&#xEC49;" Label="Balanced" ToolTip="Power mode" />
                                            </UniformGrid>

                                            <Grid x:Name="DevicesPanel" Grid.RowSpan="3" Visibility="Collapsed" Opacity="0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="24" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Sound output" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Dim}" Margin="10,0" VerticalAlignment="Center" />
                                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                                                    <StackPanel x:Name="DevicesList" />
                                                </ScrollViewer>
                                            </Grid>

                                            <StackPanel Grid.Row="4" VerticalAlignment="Bottom">
                                                <Grid Height="30">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="30" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="MuteBtn" Style="{StaticResource CircleButton}" ToolTip="Mute">
                                                        <TextBlock x:Name="VolGlyph" Text="&#xE995;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                                                    </Button>
                                                    <c:PillSlider x:Name="VolSlider" Grid.Column="1" Height="24" TrackHeight="6" Margin="8,0" />
                                                    <Button x:Name="OutputBtn" Grid.Column="2" Style="{StaticResource CircleButton}">
                                                        <TextBlock x:Name="OutputGlyph" Text="&#xE7F5;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                                                    </Button>
                                                </Grid>
                                                <Grid x:Name="BriRow" Height="30" Margin="0,2,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="30" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="30" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="&#xE706;" FontFamily="{StaticResource IconFont}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <c:PillSlider x:Name="BriSlider" Grid.Column="1" Height="24" TrackHeight="6" Margin="8,0" />
                                                    <TextBlock x:Name="BriText" Grid.Column="2" FontSize="10.5" Foreground="{StaticResource Dim}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Grid>

                                    <!-- ================= PAGE 2 · SYSTEM ================= -->
                                    <Grid Width="440" Height="216">
                                        <Grid Margin="22,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="84" />
                                                <RowDefinition Height="8" />
                                                <RowDefinition Height="28" />
                                                <RowDefinition Height="6" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <UniformGrid Columns="4">
                                                <StackPanel>
                                                    <Grid Width="58" Height="58">
                                                        <c:RingGauge x:Name="CpuRing" RingBrush="#0A84FF" />
                                                        <TextBlock x:Name="CpuText" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock Text="CPU" FontSize="10.5" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <Grid Width="58" Height="58">
                                                        <c:RingGauge x:Name="RamRing" RingBrush="#BF5AF2" />
                                                        <TextBlock x:Name="RamText" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock x:Name="RamLabel" Text="Memory" FontSize="10.5" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <Grid Width="58" Height="58">
                                                        <c:RingGauge x:Name="DiskRing" RingBrush="#64D2FF" />
                                                        <TextBlock x:Name="DiskText" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock x:Name="DiskLabel" Text="Disk C:" FontSize="10.5" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <Grid Width="58" Height="58">
                                                        <c:RingGauge x:Name="BatRing" RingBrush="#30D158" />
                                                        <TextBlock x:Name="BatText" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <TextBlock x:Name="BatLabel" Text="Battery" FontSize="10.5" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                                                </StackPanel>
                                            </UniformGrid>
                                            <Border Grid.Row="2" CornerRadius="10" Background="#17171A">
                                                <Grid Margin="12,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE74B;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#30D158" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="NetDown" FontSize="11.5" Margin="6,0,0,0" Typography.NumeralAlignment="Tabular" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="&#xE74A;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#0A84FF" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="NetUp" FontSize="11.5" Margin="6,0,0,0" Typography.NumeralAlignment="Tabular" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                        <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                                                        <TextBlock x:Name="UptimeText" FontSize="11.5" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <Grid Grid.Row="4" Margin="0,2,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <!-- connection quality -->
                                                <Border CornerRadius="14" Background="#17171A" Padding="13,8,13,8">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <Grid>
                                                            <TextBlock x:Name="NetName" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,30,0" />
                                                            <StackPanel x:Name="SignalBars" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Height="12">
                                                                <Rectangle Width="3" Height="4" RadiusX="1" RadiusY="1" Margin="1,0" VerticalAlignment="Bottom" Fill="#3AFFFFFF" />
                                                                <Rectangle Width="3" Height="6.5" RadiusX="1" RadiusY="1" Margin="1,0" VerticalAlignment="Bottom" Fill="#3AFFFFFF" />
                                                                <Rectangle Width="3" Height="9" RadiusX="1" RadiusY="1" Margin="1,0" VerticalAlignment="Bottom" Fill="#3AFFFFFF" />
                                                                <Rectangle Width="3" Height="12" RadiusX="1" RadiusY="1" Margin="1,0" VerticalAlignment="Bottom" Fill="#3AFFFFFF" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock x:Name="NetQuality" FontSize="10.5" Foreground="{StaticResource Dim}" Margin="0,2,0,0" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                            <Ellipse x:Name="PingDot" Width="6" Height="6" Fill="#3AFFFFFF" VerticalAlignment="Center" />
                                                            <TextBlock Text="Ping" FontSize="11" Foreground="{StaticResource Dim}" Margin="6,0,0,0" />
                                                            <TextBlock x:Name="PingText" FontSize="11" FontWeight="SemiBold" Margin="6,0,0,0" Typography.NumeralAlignment="Tabular" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <!-- battery health -->
                                                <Border Grid.Column="2" CornerRadius="14" Background="#17171A" Padding="13,8,13,8">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <Grid>
                                                            <TextBlock Text="Battery health" FontSize="12" FontWeight="SemiBold" />
                                                            <TextBlock x:Name="HealthText" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                        </Grid>
                                                        <TextBlock x:Name="DrawText" FontSize="10.5" Foreground="{StaticResource Dim}" Margin="0,2,0,0" />
                                                        <TextBlock x:Name="CapacityText" FontSize="11" Margin="0,5,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Grid>
                                    </Grid>

                                    <!-- ================= PAGE 3 · TOOLS ================= -->
                                    <Grid Width="440" Height="216">
                                        <Grid Margin="22,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="178" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border CornerRadius="20" Background="#17171A" Margin="0,2,0,6">
                                                <StackPanel Margin="14,10,14,0">
                                                    <Grid>
                                                        <TextBlock Text="Timer" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Dim}" />
                                                        <TextBlock x:Name="TimerHint" FontSize="10" Foreground="{StaticResource Dim}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <TextBlock x:Name="TimerText" Text="25:00" FontSize="40" FontWeight="Light" HorizontalAlignment="Center"
                                                               FontFamily="Segoe UI Variable Display, Segoe UI" Typography.NumeralAlignment="Tabular" Margin="0,2,0,0" />
                                                    <c:PillSlider x:Name="TimerBar" Height="8" TrackHeight="4" IsInteractive="False" IsHitTestVisible="False" FillBrush="#FF9F0A" Margin="0,2,0,10" />
                                                    <UniformGrid x:Name="TimerChips" Columns="4" Margin="-2,0">
                                                        <Button Style="{StaticResource Capsule}" Tag="5" Content="5m" Margin="2,0" Padding="0" />
                                                        <Button Style="{StaticResource Capsule}" Tag="15" Content="15m" Margin="2,0" Padding="0" />
                                                        <Button Style="{StaticResource Capsule}" Tag="25" Content="25m" Margin="2,0" Padding="0" />
                                                        <Button Style="{StaticResource Capsule}" Tag="50" Content="50m" Margin="2,0" Padding="0" />
                                                    </UniformGrid>
                                                    <UniformGrid Columns="2" Margin="-3,8,-3,0">
                                                        <Button x:Name="TimerStart" Style="{StaticResource Capsule}" Background="#FF9F0A" Content="Start" Margin="3,0" Height="30" FontWeight="SemiBold" />
                                                        <Button x:Name="TimerReset" Style="{StaticResource Capsule}" Content="Reset" Margin="3,0" Height="30" />
                                                    </UniformGrid>
                                                </StackPanel>
                                            </Border>
                                            <UniformGrid x:Name="ActionsGrid" Grid.Column="2" Columns="3" Rows="3" Margin="0,0,0,4">
                                                <c:QuickToggle Style="{StaticResource ActionTile}" Tag="snip" Glyph="&#xE924;" Label="Snip" ToolTip="Screenshot (Win+Shift+S)" />
                                                <c:QuickToggle Style="{StaticResource ActionTile}" Tag="taskmgr" Glyph="&#xE9D9;" Label="Task Manager" />
                                                <c:QuickToggle Style="{StaticResource ActionTile}" Tag="explorer" Glyph="&#xEC50;" Label="Files" />
                                                <c:QuickToggle Style="{StaticResource ActionTile}" Tag="terminal" Glyph="&#xE756;" Label="Terminal" />
                                                <c:QuickToggle Style="{StaticResource ActionTile}" Tag="calc" Glyph="&#xE8EF;" Label="Calculator" />
                                                <c:QuickToggle Style="{StaticResource ActionTile}" Tag="clipboard" Glyph="&#xF0E3;" Label="Clip history" ToolTip="Windows clipboard history (Win+V)" />
                                                <c:QuickToggle Style="{StaticResource ActionTile}" Tag="settings" Glyph="&#xE713;" Label="Settings" />
                                                <c:QuickToggle Style="{StaticResource ActionTile}" Tag="lock" Glyph="&#xE72E;" Label="Lock" />
                                                <c:QuickToggle Style="{StaticResource ActionTile}" Tag="sleep" Glyph="&#xE7E8;" Label="Sleep" ToolTip="Click twice to sleep" />
                                            </UniformGrid>
                                        </Grid>
                                    </Grid>

                                    <!-- ================= PAGE 4 · CLIPBOARD & FILES ================= -->
                                    <Grid Width="440" Height="216">
                                        <Grid Margin="22,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition />
                                            </Grid.ColumnDefinitions>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="26" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Clipboard" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="4,0" />
                                                <Button x:Name="ClipClear" Style="{StaticResource CircleButton}" Width="24" Height="24" HorizontalAlignment="Right" ToolTip="Clear">
                                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource Dim}" />
                                                </Button>
                                                <StackPanel x:Name="ClipList" Grid.Row="1" />
                                                <TextBlock x:Name="ClipEmpty" Grid.Row="1" Text="Copy text and it shows up here.&#x0a;Click an item to copy it again." TextWrapping="Wrap"
                                                           FontSize="11" Foreground="#66FFFFFF" Margin="4,8" />
                                            </Grid>
                                            <Grid Grid.Column="2">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="26" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Recent files" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="4,0" />
                                                <Button x:Name="OpenDownloads" Style="{StaticResource CircleButton}" Width="24" Height="24" HorizontalAlignment="Right" ToolTip="Open Downloads">
                                                    <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{StaticResource Dim}" />
                                                </Button>
                                                <StackPanel x:Name="FilesList" Grid.Row="1" />
                                            </Grid>
                                        </Grid>
                                    </Grid>

                                    <!-- ================= PAGE 5 · SMART ================= -->
                                    <Grid Width="440" Height="216">
                                        <Grid Margin="22,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="38" />
                                            </Grid.RowDefinitions>
                                            <UniformGrid x:Name="SmartGrid" Columns="2" Rows="3" />
                                            <Border Grid.Row="1" CornerRadius="12" Background="#17171A" Margin="0,2,0,6" Padding="12,0,6,0">
                                                <Grid>
                                                    <TextBlock Text="Break reminder every" FontSize="11.5" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
                                                    <StackPanel x:Name="BreakChips" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Grid>

                                    <!-- ================= PAGE 6 · NOTCH SETTINGS ================= -->
                                    <Grid Width="440" Height="216">
                                        <Grid Margin="22,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="22" />
                                            </Grid.RowDefinitions>
                                            <UniformGrid x:Name="SettingsGrid" Columns="2" Rows="6" />
                                            <TextBlock Grid.Row="1" FontSize="10.5" Foreground="#66FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Text="Win+Alt+N opens the notch · drag sideways or swipe the touchpad to change page" />
                                        </Grid>
                                    </Grid>

                                </StackPanel>
                            </Canvas>
                        </Grid>

                        <StackPanel x:Name="Dots" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2" />
                    </Grid>

                    <!-- thin coloured rim along the notch's sides and bottom (colour set from code) -->
                    <Border x:Name="Rim" BorderThickness="1,0,1,1.2" CornerRadius="0,0,3,3" IsHitTestVisible="False" BorderBrush="Transparent" />
                </Grid>
            </Border>

            <Path x:Name="EarR" Width="10" Height="10" VerticalAlignment="Top" Fill="Black"
                  Data="M10,0 L0,0 L0,10 A10,10 0 0 1 10,0 Z" />
        </StackPanel>

        <!-- A second live activity splits off into its own little island on the left -->
        <Border x:Name="SecondBubble" Background="Black" Height="30" MinWidth="30" CornerRadius="0,0,15,15" Padding="10,0"
                HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SecondScale" />
                    <TranslateTransform x:Name="SecondShift" />
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
                <Border x:Name="SecondRim" BorderThickness="1,0,1,1.2" CornerRadius="0,0,15,15" Margin="-10,0" BorderBrush="Transparent" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,1">
                    <Border x:Name="SecondArt" Width="18" Height="18" CornerRadius="9" Visibility="Collapsed" />
                    <TextBlock x:Name="SecondGlyph" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock x:Name="SecondText" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"
                               FontFamily="Segoe UI Variable Display, Segoe UI" Typography.NumeralAlignment="Tabular" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Mic / camera in use: a small companion bubble next to the notch -->
        <Border x:Name="PrivacyBubble" Background="Black" Height="22" CornerRadius="0,0,11,11" Padding="9,0"
                HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed" Opacity="0" RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PrivacyScale" />
                    <TranslateTransform x:Name="PrivacyShift" />
                </TransformGroup>
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,1">
                <Grid x:Name="MicDot" Margin="0,0,0,0">
                    <TextBlock Text="&#xE720;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#FF9F0A" VerticalAlignment="Center" />
                </Grid>
                <Grid x:Name="CamDot" Margin="6,0,0,0">
                    <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="#30D158" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
