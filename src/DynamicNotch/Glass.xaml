<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:DynamicNotch.Controls">
    <!--
        The glass themes' controls (Liquid glass, Crystal, Abyss): the same parts and behaviour as App.xaml's, made
        of glass. A translucent body, a bright rim catching light at the top and fading down, a soft sheen on the
        upper half. Each theme fills in the colours (LookTile, LookEdge, LookSheen, LookLabel, LookSwitchOff,
        LookSwitchOn) on the notch window; nothing here animates on its own.
    -->

    <!-- media controls, small icons: a glass bead lights up under the pointer -->
    <Style x:Key="GlCircleButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform />
                        </Grid.RenderTransform>
                        <Ellipse x:Name="Hover" Fill="{DynamicResource LookTile}" Stroke="{DynamicResource LookEdge}" StrokeThickness="1" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.86" ScaleY="0.86" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- list rows: a pane of glass slides under the pointer -->
    <Style x:Key="GlRowButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="11" Padding="10,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LookTile}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource LookEdge}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LookSheen}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- control-center toggles: glass discs; on, the colour pours in under the glass -->
    <Style x:Key="GlQuickToggle" TargetType="{x:Type c:QuickToggle}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:QuickToggle}">
                    <StackPanel Background="Transparent">
                        <Grid x:Name="Disc" Width="42" Height="42" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform />
                            </Grid.RenderTransform>
                            <Ellipse Fill="{DynamicResource LookTile}" />
                            <Ellipse x:Name="On" Fill="{TemplateBinding OnBrush}" Opacity="0" />
                            <Ellipse Fill="{DynamicResource LookSheen}" Margin="3,2,3,20" IsHitTestVisible="False" />
                            <Ellipse Stroke="{DynamicResource LookEdge}" StrokeThickness="1" />
                            <Ellipse x:Name="Hover" Fill="White" Opacity="0" />
                            <TextBlock Text="{TemplateBinding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{TemplateBinding Label}" FontSize="10.5" Foreground="{DynamicResource LookLabel}" Margin="0,5,0,0"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="64" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOn" Value="True">
                            <Setter TargetName="On" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.07" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Disc" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.88" ScaleY="0.88" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- tool tiles: glass squircles tinted with the tool's colour -->
    <Style x:Key="GlActionTile" TargetType="{x:Type c:QuickToggle}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="OnBrush" Value="#FF453A" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:QuickToggle}">
                    <StackPanel Background="Transparent" VerticalAlignment="Center">
                        <Grid x:Name="Disc" Width="42" Height="42" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform />
                            </Grid.RenderTransform>
                            <Border CornerRadius="13" Background="{DynamicResource LookTile}" />
                            <Border x:Name="Tint" CornerRadius="13" Background="{TemplateBinding TintBrush}" Opacity="0.16" />
                            <Border CornerRadius="12,12,8,8" Background="{DynamicResource LookSheen}" Margin="2,1,2,20" IsHitTestVisible="False" />
                            <Border x:Name="On" CornerRadius="13" Background="{TemplateBinding OnBrush}" Opacity="0" />
                            <Border CornerRadius="13" BorderBrush="{DynamicResource LookEdge}" BorderThickness="1" />
                            <Border x:Name="Hover" CornerRadius="13" Background="White" Opacity="0" />
                            <TextBlock x:Name="Icon" Text="{TemplateBinding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       Foreground="{TemplateBinding TintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{TemplateBinding Label}" FontSize="10" Foreground="{DynamicResource LookLabel}" Margin="0,4,0,0"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="66" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOn" Value="True">
                            <Setter TargetName="On" Property="Opacity" Value="1" />
                            <Setter TargetName="Icon" Property="Foreground" Value="Black" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.07" />
                            <Setter TargetName="Tint" Property="Opacity" Value="0.26" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Disc" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.88" ScaleY="0.88" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- switch: a glass track; on, it fills with the theme's colour; a pearl knob glides across -->
    <Style x:Key="GlSwitch" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="36" Height="21" Background="Transparent">
                        <Border CornerRadius="10.5" Background="{DynamicResource LookSwitchOff}" BorderBrush="{DynamicResource LookEdge}" BorderThickness="1" />
                        <Border x:Name="OnTrack" CornerRadius="10.5" Background="{DynamicResource LookSwitchOn}" Opacity="0" />
                        <Ellipse x:Name="Knob" Width="17" Height="17" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="15" Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction><c:SpringEase Damping="0.6" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.35">
                                            <DoubleAnimation.EasingFunction><c:SpringEase Damping="0.6" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- chips (timer minutes, tabs, start / reset): glass capsules with a light-catching rim -->
    <Style x:Key="GlCapsule" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource LookTile}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Border CornerRadius="13" Background="{TemplateBinding Background}" />
                        <Border CornerRadius="12,12,6,6" Background="{DynamicResource LookSheen}" Margin="2,1,2,10" IsHitTestVisible="False" />
                        <Border CornerRadius="13" BorderBrush="{DynamicResource LookEdge}" BorderThickness="1" />
                        <Border x:Name="Hover" CornerRadius="13" Background="White" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.08" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.94" ScaleY="0.94" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- scrollbars: a slim glass pill -->
    <Style x:Key="GlScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="2" Width="4" Background="#59FFFFFF" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
