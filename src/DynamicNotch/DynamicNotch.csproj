<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <AssemblyName>DynamicNotch</AssemblyName>
    <RootNamespace>DynamicNotch</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>

    <!-- What Windows shows in the exe's Properties > Details and in Settings > Apps -->
    <Version>1.7.5</Version>
    <Product>Dynamic Notch</Product>
    <AssemblyTitle>Dynamic Notch</AssemblyTitle>
    <Description>A smooth Dynamic-Island-style notch and control center for Windows.</Description>
    <Company>Prism99-collab</Company>
    <Copyright>Copyright (c) 2026 Prism99-collab</Copyright>

    <!-- Workstation GC with background collections: full collections run beside the UI thread instead of
         pausing it mid-animation (a blocking GC was a source of random micro-stutters). -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <!-- Release builds for distribution: one self-contained .exe, no .NET install needed on the target PC -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- no single-file compression: the installer's LZMA compresses the raw exe far better -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; don't let its namespaces leak into WPF code. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- gentle memory conservation (0-9); the heavy lifting is the idle compaction in NotchWindow -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\notification.wav" />
    <EmbeddedResource Include="Assets\notification.wav" LogicalName="DynamicNotch.Assets.notification.wav" />
    <!-- the Cyberpunk theme's default page backgrounds (a picture in the user's Backgrounds folder wins) -->
    <EmbeddedResource Include="Assets\Backgrounds\page*.*" LogicalName="DynamicNotch.Backgrounds.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- the optional browser extension (every playing tab in the notch), ready to load next to the app:
         extension\chromium for Chrome, Edge, Brave, Opera, Vivaldi; extension\firefox for Firefox -->
    <None Include="..\..\browser-extension\shared\*" Link="extension\chromium\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\browser-extension\chromium\manifest.json" Link="extension\chromium\manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\browser-extension\shared\*" Link="extension\firefox\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\browser-extension\firefox\manifest.json" Link="extension\firefox\manifest.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
