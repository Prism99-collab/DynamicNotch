<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:DynamicNotch.Controls">
    <!--
        The cyberpunk skin's controls: the same parts and behaviour as the originals in App.xaml, cut at 45°
        instead of rounded, in the 2077 palette. Swapped in by NotchWindow.CyberSkin while the theme is on.
    -->

    <SolidColorBrush x:Key="CyYellow" Color="#FEE801" />
    <SolidColorBrush x:Key="CyCyan" Color="#54C1E6" />
    <SolidColorBrush x:Key="CyNight" Color="#00060E" />
    <SolidColorBrush x:Key="CyEdge" Color="#4054C1E6" />
    <SolidColorBrush x:Key="CyPlate" Color="#0C1D27" />

    <!-- media controls, small icons: an octagon lights up under the pointer -->
    <Style x:Key="CyCircleButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform />
                        </Grid.RenderTransform>
                        <Path x:Name="Hover" Stretch="Fill" Data="M3,0 L7,0 L10,3 L10,7 L7,10 L3,10 L0,7 L0,3 Z"
                              Fill="#1854C1E6" Stroke="#FEE801" StrokeThickness="1" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.86" ScaleY="0.86" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- list rows: square, a yellow bar slides in on the left under the pointer -->
    <Style x:Key="CyRowButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <Rectangle x:Name="Bar" Width="2" HorizontalAlignment="Left" Margin="0,5" Fill="#FEE801" Opacity="0" />
                        <Path x:Name="Corner" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Data="M6,0 L6,6 L0,6 Z" Fill="#54C1E6" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1A54C1E6" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            <Setter TargetName="Corner" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#33FEE801" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- control-center toggles: a cut plate with a cyan edge; on, it fills with its colour and a yellow tick marks it -->
    <Style x:Key="CyQuickToggle" TargetType="{x:Type c:QuickToggle}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:QuickToggle}">
                    <StackPanel Background="Transparent">
                        <Grid x:Name="Disc" Width="42" Height="42" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform />
                            </Grid.RenderTransform>
                            <Path Data="M0,0 L32,0 L42,10 L42,42 L10,42 L0,32 Z" Fill="{StaticResource CyPlate}" Stroke="{StaticResource CyEdge}" StrokeThickness="1" />
                            <Path x:Name="On" Data="M0,0 L32,0 L42,10 L42,42 L10,42 L0,32 Z" Fill="{TemplateBinding OnBrush}" Opacity="0" />
                            <Path x:Name="Tick" Data="M0,0 L9,0 L0,9 Z" Fill="#FEE801" Margin="3,3,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Opacity="0" />
                            <Path x:Name="Hover" Data="M0,0 L32,0 L42,10 L42,42 L10,42 L0,32 Z" Fill="Transparent" Stroke="#FEE801" StrokeThickness="1" Opacity="0" />
                            <TextBlock x:Name="Icon" Text="{TemplateBinding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{TemplateBinding Label}" FontSize="10.5" Foreground="#B054C1E6" Margin="0,5,0,0"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="64" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOn" Value="True">
                            <Setter TargetName="On" Property="Opacity" Value="1" />
                            <Setter TargetName="Tick" Property="Opacity" Value="1" />
                            <Setter TargetName="Icon" Property="Foreground" Value="#00060E" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Disc" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.88" ScaleY="0.88" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- tool tiles: the same plate, tinted with the tool's colour -->
    <Style x:Key="CyActionTile" TargetType="{x:Type c:QuickToggle}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="OnBrush" Value="#FF2A4F" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:QuickToggle}">
                    <StackPanel Background="Transparent" VerticalAlignment="Center">
                        <Grid x:Name="Disc" Width="42" Height="42" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform />
                            </Grid.RenderTransform>
                            <Path Data="M0,0 L32,0 L42,10 L42,42 L10,42 L0,32 Z" Fill="{StaticResource CyPlate}" Stroke="{StaticResource CyEdge}" StrokeThickness="1" />
                            <Path x:Name="Tint" Data="M0,0 L32,0 L42,10 L42,42 L10,42 L0,32 Z" Fill="{TemplateBinding TintBrush}" Opacity="0.16" />
                            <Path x:Name="On" Data="M0,0 L32,0 L42,10 L42,42 L10,42 L0,32 Z" Fill="{TemplateBinding OnBrush}" Opacity="0" />
                            <Path x:Name="Hover" Data="M0,0 L32,0 L42,10 L42,42 L10,42 L0,32 Z" Fill="Transparent" Stroke="#FEE801" StrokeThickness="1" Opacity="0" />
                            <TextBlock x:Name="Icon" Text="{TemplateBinding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       Foreground="{TemplateBinding TintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{TemplateBinding Label}" FontSize="10" Foreground="#B054C1E6" Margin="0,4,0,0"
                                   HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="66" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOn" Value="True">
                            <Setter TargetName="On" Property="Opacity" Value="1" />
                            <Setter TargetName="Icon" Property="Foreground" Value="#00060E" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="0.9" />
                            <Setter TargetName="Tint" Property="Opacity" Value="0.28" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Disc" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.88" ScaleY="0.88" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- switch: a cut track; the square knob slides across and the track fills yellow -->
    <Style x:Key="CySwitch" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="36" Height="18" Background="Transparent">
                        <Path Data="M0,0 L30,0 L36,6 L36,18 L6,18 L0,12 Z" Fill="#132A35" Stroke="{StaticResource CyEdge}" StrokeThickness="1" />
                        <Path x:Name="OnTrack" Data="M0,0 L30,0 L36,6 L36,18 L6,18 L0,12 Z" Fill="#FEE801" Opacity="0" />
                        <Rectangle x:Name="Knob" Width="12" Height="12" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                            <Rectangle.RenderTransform>
                                <TranslateTransform />
                            </Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Knob" Property="Fill" Value="#00060E" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="18" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.16">
                                            <DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- chips (timer minutes, start / reset): a square plate with a cyan edge and a yellow corner tag -->
    <Style x:Key="CyCapsule" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource CyPlate}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource CyEdge}" BorderThickness="1" />
                        <Path Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Bottom" Data="M6,0 L6,6 L0,6 Z" Fill="#FEE801" />
                        <Border x:Name="Hover" BorderBrush="#FEE801" BorderThickness="1" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.93" ScaleY="0.93" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- the lock button: a cut gold plate -->
    <ControlTemplate x:Key="CyLockTemplate" TargetType="Button">
        <Grid x:Name="Bg" Background="Transparent">
            <Path Stretch="Fill" Data="M0,0 L15,0 L22,7 L22,22 L7,22 L0,15 Z" Stroke="#9A9F17" StrokeThickness="1.2">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FEE801" Offset="0" />
                        <GradientStop Color="#E0B800" Offset="1" />
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="10.5" Foreground="#00060E"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.85" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.65" /></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- scrollbars: a thin yellow sliver -->
    <Style x:Key="CyScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="4" />
        <Setter Property="MinWidth" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="#1454C1E6">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Rectangle Fill="#FEE801" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
