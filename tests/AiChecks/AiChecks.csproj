<Project Sdk="Microsoft.NET.Sdk">

  <!-- The AI's checks: run before every install (dotnet run -c Release). Fails (exit 1) when one goes wrong. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);WFO0003;NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DynamicNotch\DynamicNotch.csproj" />
    <None Include="cases.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
